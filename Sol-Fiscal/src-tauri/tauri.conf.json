{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sol Fiscal",
  "version": "1.0.0",
  "identifier": "br.com.solfiscal.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sol Fiscal",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Sol",
    "category": "Business",
    "shortDescription": "Ferramenta fiscal offline-first do ecossistema Sol.",
    "longDescription": "Sol Fiscal focado no motor cClassTrib, importação PDF/XLSX/CSV/TXT, revisão assistida, aplicação de alternativas, exportação e histórico local.",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Sol Fiscal",
        "compression": "lzma"
      },
      "bundleVCRuntime": true
    }
  }
}
